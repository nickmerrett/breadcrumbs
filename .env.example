# Copy this file to .env and fill in your values before running docker compose up -d

# One or more name:key pairs, comma-separated.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: BREADCRUMBS_KEYS=me:key1,code:key2
BREADCRUMBS_KEYS=

# Comma-separated agent names (key names from BREADCRUMBS_KEYS) whose saves are auto-approved.
# Agents not listed here land as 'proposed' and need manual review.
# Example: BREADCRUMBS_TRUSTED_AGENTS=me,bob
BREADCRUMBS_TRUSTED_AGENTS=

# Only needed when running behind a reverse proxy or tunnel.
# Must match the public address clients use (used in OAuth discovery).
# Example: BREADCRUMBS_PUBLIC_URL=https://crumbs.example.com
BREADCRUMBS_PUBLIC_URL=
